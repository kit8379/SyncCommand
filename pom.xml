<?xml version="1.0" encoding="UTF-8"?>
<project
        xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.me</groupId>
    <artifactId>SyncCommand</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <name>SyncCommand</name>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spigot.version>26.2-R0.1-SNAPSHOT</spigot.version>
        <velocity.version>3.5.0-SNAPSHOT</velocity.version>
        <bungeecord.version>1.21-R0.4</bungeecord.version>

        <annotations.version>26.1.0</annotations.version>
        <configurate.version>4.2.0</configurate.version>
        <jedis.version>7.5.3</jedis.version>
        <folialib.version>0.5.1</folialib.version>

        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
    </properties>

    <build>
        <finalName>${project.artifactId}</finalName>

        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>

                    <!-- Required for Velocity @Plugin annotation processing -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.velocitypowered</groupId>
                            <artifactId>velocity-api</artifactId>
                            <version>${velocity.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Shade Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <id>shade</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Do not generate a dependency-reduced POM -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!-- Do not minimize FoliaLib/Jedis/Configurate unless fully tested -->
                            <minimizeJar>false</minimizeJar>

                            <relocations>
                                <!-- Configurate -->
                                <relocation>
                                    <pattern>org.spongepowered</pattern>
                                    <shadedPattern>org.me.synccommand.shaded.org.spongepowered</shadedPattern>
                                </relocation>

                                <!-- Configurate transitive dependency -->
                                <relocation>
                                    <pattern>io.leangen.geantyref</pattern>
                                    <shadedPattern>org.me.synccommand.shaded.io.leangen.geantyref</shadedPattern>
                                </relocation>

                                <!-- YAML parser used by Configurate YAML -->
                                <relocation>
                                    <pattern>org.yaml.snakeyaml</pattern>
                                    <shadedPattern>org.me.synccommand.shaded.org.yaml.snakeyaml</shadedPattern>
                                </relocation>

                                <!-- Jedis -->
                                <relocation>
                                    <pattern>redis.clients</pattern>
                                    <shadedPattern>org.me.synccommand.shaded.redis.clients</shadedPattern>
                                </relocation>

                                <!-- Jedis transitive dependency -->
                                <relocation>
                                    <pattern>org.apache.commons.pool2</pattern>
                                    <shadedPattern>org.me.synccommand.shaded.org.apache.commons.pool2</shadedPattern>
                                </relocation>

                                <!-- FoliaLib -->
                                <relocation>
                                    <pattern>com.tcoded.folialib</pattern>
                                    <shadedPattern>org.me.synccommand.shaded.com.tcoded.folialib</shadedPattern>
                                </relocation>
                            </relocations>

                            <!-- Filters -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/groups/public/</url>
        </repository>

        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>

        <repository>
            <id>tcoded-releases</id>
            <url>https://repo.tcoded.com/releases</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- JetBrains Annotations -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>${annotations.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Spigot API -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${spigot.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Velocity API -->
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>${velocity.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- BungeeCord API -->
        <dependency>
            <groupId>net.md-5</groupId>
            <artifactId>bungeecord-api</artifactId>
            <version>${bungeecord.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Configurate YAML -->
        <dependency>
            <groupId>org.spongepowered</groupId>
            <artifactId>configurate-yaml</artifactId>
            <version>${configurate.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- Jedis -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- FoliaLib -->
        <dependency>
            <groupId>com.tcoded</groupId>
            <artifactId>FoliaLib</artifactId>
            <version>${folialib.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>